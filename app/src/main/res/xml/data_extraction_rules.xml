<?xml version="1.0" encoding="utf-8"?>
<!-- Drive-test databases can be large and are exported explicitly; keep them out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
