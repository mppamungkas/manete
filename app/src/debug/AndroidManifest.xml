<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            Debug builds only: renders the launcher icon previews and checks the safe zone, started with
            `adb shell am start -n id.my.pamslab.netlogger/.IconPreviewActivity`. An activity rather than an
            instrumented test of :app, because connectedAndroidTest uninstalls the app and wipes its data.
        -->
        <activity
            android:name=".IconPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="ExportedActivity" />
        <!--
            Debug builds only: crashes the app on purpose to check the problem reports (decision 005, D6).
            DUMP is held by the shell, not by normal apps, so only `adb shell am broadcast` can trigger it.
        -->
        <receiver
            android:name=".CrashTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />
        <receiver
            android:name=".CrashTestVpnReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":vpn"
            tools:ignore="ExportedReceiver" />
    </application>
</manifest>
